# Copy this file to .env and replace the placeholder with your Groq key.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Optional: turn on LangSmith only if you have a key.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=replace_with_langsmith_key
# LANGSMITH_PROJECT=docker-langgraph-class
